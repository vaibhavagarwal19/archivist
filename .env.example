APP_NAME=Archivist
APP_VERSION=1.0.0
DEBUG=true
API_V1_PREFIX=/api/v1

# Signing key for JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Startup fails if this is left at the placeholder while DEBUG=false.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- Chat model -------------------------------------------------------------
# Groq serves open models fast and has a free tier. Get a key at console.groq.com
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# --- Embeddings -------------------------------------------------------------
# Configured separately from the chat model: Groq has no embeddings endpoint.
# "fastembed" runs a small ONNX model in-process - no API key, no network call.
# Alternatives: "openai" (set EMBEDDING_API_KEY + EMBEDDING_BASE_URL) or
# "ollama" (set OLLAMA_BASE_URL and run Ollama locally).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- Storage ----------------------------------------------------------------
# SQLite is fine for local development; use Postgres in deployment.
DATABASE_URL=sqlite:///./internal_ai_agents.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/internal_ai_agents

FAISS_INDEX_PATH=storage/faiss/index
UPLOAD_DIR=storage/uploads

# --- Background jobs (optional) ---------------------------------------------
# Uploads work without Redis; set to true only when a Celery worker is running.
ENABLE_BACKGROUND_TASKS=false
REDIS_URL=redis://localhost:6379/0

# --- Frontend ---------------------------------------------------------------
# Where the Streamlit UI looks for the API (set to the service URL in Docker).
API_BASE_URL=http://127.0.0.1:8000
